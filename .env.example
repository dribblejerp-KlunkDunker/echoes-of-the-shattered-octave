# Copy to tools/archil/.env (gitignored) for the Archil disk tools. Keys are server-side only:
# never rename these with a NEXT_PUBLIC_ or VITE_ prefix, and never import tools/archil/store.js
# from a browser script.

# API key from https://console.archil.com/api-keys. Starts with "key-".
# A disk/mount token (adt_...) or a key made in another region gets HTTP 401.
ARCHIL_API_KEY=

# Region the key was made in: aws-us-east-1 (default), aws-us-west-2, aws-eu-west-1 or gcp-us-central1.
# Exec runs only in aws-us-east-1, aws-us-west-2 and aws-eu-west-1.
ARCHIL_REGION=aws-us-east-1

# The disk to use, e.g. dsk-abc123. tools/archil/check.mjs creates one and fills this in when it is empty.
ARCHIL_DISK_ID=
